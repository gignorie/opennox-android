<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Drop Shadow -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#50000000" />
        </shape>
    </item>
    <!-- Scroll Outer Metal Frame -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:startColor="#8a692e"
                android:centerColor="#573f18"
                android:endColor="#291c0a"
                android:angle="270" />
            <stroke android:width="1.5dp" android:color="#a8843e" />
        </shape>
    </item>
    <!-- Inner Scroll Parchment/Wood Core -->
    <item android:top="2dp" android:left="16dp" android:right="16dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <gradient
                android:startColor="#4a3517"
                android:centerColor="#33230d"
                android:endColor="#211506"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#6e5223" />
        </shape>
    </item>
    <!-- Left Scroll Endcap Knob -->
    <item android:left="4dp" android:top="4dp" android:bottom="6dp" android:width="10dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#cfaf5d"
                android:centerColor="#6b4f1f"
                android:endColor="#261b0a"
                android:type="radial"
                android:gradientRadius="8dp" />
            <stroke android:width="1dp" android:color="#e0c275" />
        </shape>
    </item>
    <!-- Right Scroll Endcap Knob -->
    <item android:right="4dp" android:top="4dp" android:bottom="6dp" android:width="10dp" android:gravity="end">
        <shape android:shape="oval">
            <gradient
                android:startColor="#cfaf5d"
                android:centerColor="#6b4f1f"
                android:endColor="#261b0a"
                android:type="radial"
                android:gradientRadius="8dp" />
            <stroke android:width="1dp" android:color="#e0c275" />
        </shape>
    </item>
</layer-list>
