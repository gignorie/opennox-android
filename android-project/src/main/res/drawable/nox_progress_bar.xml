<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#1a140e" />
            <stroke android:width="1dp" android:color="#5e4922" />
        </shape>
    </item>
    <!-- Progress fill -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <gradient
                    android:startColor="#f0c25a"
                    android:centerColor="#bf9132"
                    android:endColor="#735214"
                    android:angle="270" />
                <stroke android:width="1dp" android:color="#ffd878" />
            </shape>
        </clip>
    </item>
</layer-list>
