<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Dark Slate / Stone Base Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1a1714"
                android:centerColor="#100e0c"
                android:endColor="#080706"
                android:angle="270" />
        </shape>
    </item>

    <!-- Outer Medieval Bronze Border -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#594420" />
            <corners android:radius="4dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Inner Thin Gold Filigree Line -->
    <item android:top="12dp" android:bottom="12dp" android:left="12dp" android:right="12dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#7a5f2e" />
            <corners android:radius="2dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
