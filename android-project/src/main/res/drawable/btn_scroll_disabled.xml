<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Scroll Outer Frame (Muted Gray-Brown) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:startColor="#3b3329"
                android:centerColor="#26211a"
                android:endColor="#14110e"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#42392d" />
        </shape>
    </item>
    <!-- Inner Scroll Parchment -->
    <item android:top="2dp" android:left="16dp" android:right="16dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <gradient
                android:startColor="#1f1b16"
                android:centerColor="#171410"
                android:endColor="#12100d"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#2e271f" />
        </shape>
    </item>
    <!-- Left Scroll Endcap Knob -->
    <item android:left="4dp" android:top="4dp" android:bottom="6dp" android:width="10dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#4f4639"
                android:centerColor="#29241d"
                android:endColor="#14120e"
                android:type="radial"
                android:gradientRadius="8dp" />
            <stroke android:width="1dp" android:color="#594f41" />
        </shape>
    </item>
    <!-- Right Scroll Endcap Knob -->
    <item android:right="4dp" android:top="4dp" android:bottom="6dp" android:width="10dp" android:gravity="end">
        <shape android:shape="oval">
            <gradient
                android:startColor="#4f4639"
                android:centerColor="#29241d"
                android:endColor="#14120e"
                android:type="radial"
                android:gradientRadius="8dp" />
            <stroke android:width="1dp" android:color="#594f41" />
        </shape>
    </item>
</layer-list>
